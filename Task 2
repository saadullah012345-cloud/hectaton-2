
import java.util.Scanner;

public class ArrayMinMax {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int[] arr = new int[5];

        System.out.println("Enter 5 numbers:");
        for (int i = 0; i < arr.length; i++) {
            arr[i] = sc.nextInt();
        }

        int largest = arr[0];
        int smallest = arr[0];
        int secondMin = Integer.MAX_VALUE;

        int largestIndex = 0;
        int smallestIndex = 0;
        int secondMinIndex = -1;

        for (int i = 1; i < arr.length; i++) {
            if (arr[i] > largest) {
                largest = arr[i];
                largestIndex = i;
            }

            if (arr[i] < smallest) {
                smallest = arr[i];
                smallestIndex = i;
            }
        }

        for (int i = 0; i < arr.length; i++) {
            if (arr[i] > smallest &&
                arr[i] < secondMin) {
                secondMin = arr[i];
                secondMinIndex = i;
            }
        }

        System.out.println("Largest element: " + largest);
        System.out.println("Largest index: " + largestIndex);

        System.out.println("Smallest element: " + smallest);
        System.out.println("Smallest index: " + smallestIndex);

        if (secondMinIndex != -1) {
            System.out.println("Second minimum: " + secondMin);
            System.out.println("Second minimum index: " + secondMinIndex);
        } else {
            System.out.println("No second minimum distinct value exists.");
        }

        sc.close();
    }
}

